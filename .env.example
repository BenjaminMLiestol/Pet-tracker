# Copy to .env.local and point at your backend (the app appends /v1). Use https:// outside local development.
EXPO_PUBLIC_API_URL=http://localhost:8000/api

# Optional: .env.development.local overrides this only while running the dev server (Debug builds),
# for example to use a local Herd site: EXPO_PUBLIC_API_URL=https://pet-tracker-backend.test/api
